# ------------------------------------------------------------
# DCGPU Lab Monitoring - Consolidated environment configuration
# Canonical env file used by docker-compose services.
# ------------------------------------------------------------

# MongoDB
MONGODB_URL=mongodb://dcgpu_lab:amd12345@dcgpu-lab.amd.com:27017/lab-monitoring?authSource=admin
MONGODB_DB=lab-monitoring

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=amd12345

# Celery
C_FORCE_ROOT=true
TZ=Asia/Kuala_Lumpur
CELERY_BROKER_URL=redis://:amd12345@redis:6379
CELERY_RESULT_BACKEND=redis://:amd12345@redis:6379

# Celery tuning - fan speed collection configuration
FAN_SPEED_MAX_WORKERS=10
FAN_SPEED_BATCH_SIZE=33

# Prometheus multiprocess metrics configuration
PROMETHEUS_MULTIPROC_DIR=/metrics
WORKER_METRICS_PORT=9200

# Backend scanner + admin
NMAP_ADMIN_PASSWORD=amd123
# SCANNER_SERVICE_URL=http://host.docker.internal:5001

# Frontend
# For local development, uncomment the following line and comment out the production URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
# For production deployment, uncomment the following line and comment out the local development URL.
# NEXT_PUBLIC_BACKEND_URL=https://dcgpu-lab.amd.com

# Utility scripts
CONDUCTOR_MATCH_TERM=odcdh
CONDUCTOR_PAGE_SIZE=500
OUTPUT=jsonl

# RPi integration
RPI_HOSTNAME=
RPI_USERNAME=
RPI_PASSWORD=
RPI_REMOTE_FILE_PATH=

